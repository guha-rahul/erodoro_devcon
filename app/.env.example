# Frontend environment. All NEXT_PUBLIC_* values are bundled into the
# static export — never put secrets here.

# Target chain: 84532 (Base Sepolia) until mainnet is deployed.
NEXT_PUBLIC_CHAIN_ID=84532

# Permissionless intent settlement contract on Base Sepolia.
NEXT_PUBLIC_INTENT_ADDRESS=0x8c63bbC4b077a73e67258A0F384186c316855Cd8

# Set these only after the Market Rip contracts are deployed and funded.
NEXT_PUBLIC_RIP_POOL_ADDRESS=
NEXT_PUBLIC_RIP_PUT_ADDRESS=
# Optional: scan purchase receipts from the pool deployment block.
NEXT_PUBLIC_RIP_DEPLOY_BLOCK=

# Local read RPC for `pnpm dev`. Production reads go through /rpc.
NEXT_PUBLIC_RPC_URL=

# World ID (IDKit). Proof of Human, checked by the CRE verify-human workflow via scripts/world-verifier.mjs.
NEXT_PUBLIC_WLD_APP_ID=
NEXT_PUBLIC_WLD_RP_ID=
NEXT_PUBLIC_WLD_ACTION=buy-rips
NEXT_PUBLIC_WLD_ENV=staging
NEXT_PUBLIC_WORLD_VERIFIER_URL=http://localhost:8790
# Server-only, read by scripts/world-verifier.mjs from .env.local. Never commit the signing key.
# WLD_RP_SIGNING_KEY=
# APP_ORIGIN=http://localhost:3500
