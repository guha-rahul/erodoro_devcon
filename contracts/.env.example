# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Use encrypted testnet keystores with the commands in the pilot runbook.
# Keep these raw-key fields empty. They remain only for CI compatibility.

DEPLOYER_ADDRESS=

# Use three different testnet accounts for the role-separated pilot.
SELLER_ADDRESS=
MAKER_ADDRESS=
SETTLER_ADDRESS=

# A CI job can set PRIVATE_KEY, SELLER_PRIVATE_KEY, MAKER_PRIVATE_KEY, or
# SETTLER_PRIVATE_KEY instead. Do not add raw keys to this file.

# RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Pyth receiver for the chain you are deploying to. These differ per chain and
# the mainnet address has unrelated code on Sepolia - probe before trusting it.
#   mainnet  0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a
#   sepolia  0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
PYTH_ADDRESS=

# Who holds the factory allowlists. Defaults to the deployer, which is fine on
# testnet and is a mainnet blocker. Use a multisig for anything real.
FACTORY_ADMIN=

# Equity.US.AAPL/USD - the regular-session feed. The .ON, .PRE and .POST
# variants are different ids and a series bound to one cannot settle the other.
FEED_ID=0x49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688

# --- fork suite only (see docs/base-fork-testing.md) ---
BASE_COLLATERAL=
BASE_COLLATERAL_WHALE=
BASE_PYTH=
BASE_FEED_ID=

# Coinbase total-return feed status on Base mainnet.
COINBASE_ORACLE_REGISTRY=0x3f3E8cf41cdd3b1D118c16471aB0113DfDDd5CaD
B20_TOKEN=
CHAINLINK_FEED_ID=

# UMA Optimistic Oracle V2 fallback. The values below are Base Sepolia only.
UMA_OOV2=0x99ec530a761e68a377593888d9504002bd191717
UMA_BOND_CURRENCY=0x7E6d9618Ba8a87421609352d6e711958A97e2512
UMA_IDENTIFIER=0x4153534552545f54525554480000000000000000000000000000000000000000
UMA_BOND=
UMA_LIVENESS=7200
UMA_RESOLUTION_RULES=
# One fallback per stock: the feed id of that stock's settlement configuration.
# Name the stock in UMA_RESOLUTION_RULES too. The Factory rejects a fallback
# bound to another feed.
UMA_FEED_ID=
# Base mainnet values (DeployUmaFallback checks both against UMA's whitelists):
#   UMA_OOV2=0x880d041D67aaB3B062995d11d4aD9c1018A3b02f
#   UMA_BOND_CURRENCY=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   (USDC; UMA final fee 250 USDC)
#   UMA_IDENTIFIER=0x5945535f4f525f4e4f5f51554552590000000000000000000000000000000000   (YES_OR_NO_QUERY; ASSERT_TRUTH is not whitelisted on Base mainnet)
FALLBACK_PRICE_DECIMALS=8
# 0 = RAW_SHARE, 1 = TOTAL_RETURN
FALLBACK_SETTLEMENT_MODEL=0

# Current pilot deployment. Replace these after each redeployment.
VAULT_ADDRESS=
FACTORY_ADDRESS=
ADAPTER_ADDRESS=
FALLBACK_ADAPTER_ADDRESS=
RFQ_ADDRESS=
FAUCET_ADDRESS=
QUOTE_TOKEN=
SERIES_ID=
SERIES_MATURITY=
SERIES_STRIKE=28000000000
SERIES_HORIZON=600
SETTLEMENT_MODEL=0
FALLBACK_DELAY=86400
QUOTE_NONCE=

# Testnet faucet amounts use raw token units.
FAUCET_STOCK_AMOUNT=500000000
FAUCET_QUOTE_AMOUNT=500000000
FAUCET_COOLDOWN=86400

# Permissionless intent settlement (contracts/script/DeployIntent.s.sol).
# No constructor args, no admin. Record the broadcast address here and in
# app/lib/deployment.ts, wrangler.jsonc and deployments/base-sepolia.json.
INTENT_ADDRESS=0x8c63bbC4b077a73e67258A0F384186c316855Cd8

# Auction timing (seconds). The visible MVP uses a 10-minute window.
FAST_AUCTION_SECONDS=600
SETTLEMENT_EXCLUSIVITY_SECONDS=45
DISCOVERY_AUCTION_SECONDS=600
FAST_BATCH_CREATION_INTERVAL_SECONDS=2
