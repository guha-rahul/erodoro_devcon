# Account that broadcasts simulated reports (64 hex chars, no 0x). Needs Base Sepolia ETH, and must be the
# simulation sender pinned in CreSettlementOracle and HumanRegistry (the Rips operator on the test fixture).
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=staging-settings
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
